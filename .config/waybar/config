{
  "layer": "top",
  "margin": "12px 12px 0px 12px",
  "modules-left": [
    "river/tags"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/wireguard",
    "network",
    "backlight",
    "pulseaudio",
    "battery",
  ],
  "river/tags": {
    "num-tags": 7,
    "set-tags": [
      1,
      2,
      4,
      8,
      16,
      32,
      64
    ],
    "tag-labels": [
      "",
      "2",
      "3",
      "4",
      "",
      "",
      "",
    ]
  },
  "clock": {
    "format": "{:%b %d | %H:%M}",
    "tooltip": false
  },
  "backlight": {
    "device": "amdgpu_bl0",
    "format": "<span color='#fff'>{icon}</span> {percent}%",
    "format-icons": [
      "󰃜",
      "󰃛",
      "󰃚"
    ],
    "tooltip": false
  },
  "pulseaudio": {
    "format": "<span color='#fff'>{icon}</span> {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": [
        "",
        " ",
        " "
      ]
    }
  },
  "network": {
    "interface": "wlan0",
    "format": "{ifname}",
    "format-wifi": "<span color='#fff'> </span> {essid}",
    "format-ethernet": "{ipaddr}/{cidr} ",
    "format-disconnected": "Disconnected",
    "format-linked": "<span color='#fff'></span> No Network",
    "format-disabled": "Disabled",
    "tooltip": false
  },
  "custom/wireguard": {
    "exec": "~/.local/bin/wireguard-status short",
    "format": "<span color='#fff'>󰌆 </span> {}",
    "return-type": "json",
    "interval": 2,
  },
  "battery": {
    "interval": 10,
    "format": "<span color='#fff'>{icon} </span> {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "", 
      ""
    ],
    "format-charging": "<span color='#d7ffc2'>{icon} </span> {capacity}%",
  }
}
