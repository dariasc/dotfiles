general {
    output_format = "i3bar"
}

order += "volume master"
order += "wireless wlan0"
order += "wireless wg0"
order += "battery 0"
order += "tztime local"

volume master {
    format = "V %volume"
    format_muted = "V muted (%volume)"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

wireless wlan0 {
    format_up = "W (%essid at%quality)"
    format_down = "W down"
}

wireless wg0 {
    format_up = "T (home)"
    format_down = "T down"
}

battery 0 {
    format = "%status %percentage"
    format_down = "No battery"
    status_chr = "CHR"
    status_bat = "BAT"
    status_unk = "UNK"
    status_full = "FULL"
    path = "/sys/class/power_supply/BAT%d/uevent"
    low_threshold = 10
}

tztime local {
    format = "%Y-%m-%d %H:%M:%S"
}

