#!/bin/bash

LAST_OUTPUT_FILE="/tmp/vxe-battery"

OUTPUT=$(~/.local/bin/vxe-battery-level)
EXIT_CODE=$?
SCRIPT_EXIT_CODE=0

if [ -f "$LAST_OUTPUT_FILE" ]; then
    if [ $(find "$LAST_OUTPUT_FILE" -mmin +1) ]; then
        rm "$LAST_OUTPUT_FILE"
        SCRIPT_EXIT_CODE=1
    fi
fi

if [ $EXIT_CODE -eq 0 ]; then
    echo "$OUTPUT"
    echo "$OUTPUT" > "$LAST_OUTPUT_FILE"
else
    if [ -f "$LAST_OUTPUT_FILE" ]; then
        cat "$LAST_OUTPUT_FILE"
    else
        SCRIPT_EXIT_CODE=1
    fi
fi

exit $SCRIPT_EXIT_CODE

